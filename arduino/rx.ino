#include <esp_now.h>
#include <WiFi.h>

void onDataRecv(const esp_now_recv_info *recvInfo, const uint8_t *incomingData, int len) {
  Serial0.write(incomingData, len);

  // 蓝色状态灯微弱闪烁提示（不阻塞无线中断）
  // digitalWrite(8, LOW);
  // delayMicroseconds(500);
  // digitalWrite(8, HIGH);
}

void setup() {
  Serial0.begin(9600, SERIAL_8N1, 20, 21);
  delay(1200); // 等待 CH9329 通电完毕

  // 强制工作模式 0x00（键盘 + 全功能鼠标复合模式）
  uint8_t force_mode_0[] = {
    0x57, 0xAB, 0x00, 0x09, 0x32, 0x00, 0x00, 0x00, 0x00, 0x00, 0x25, 0x80, 0x08, 0x00, 0x00, 0x03,
    0x86, 0x1A, 0x29, 0xE1, 0x00, 0x00, 0x00, 0x01, 0x00, 0x0D, 0x0A, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0xAF
  };
  Serial0.write(force_mode_0, sizeof(force_mode_0));
  delay(500); // EEPROM 写入冷却

  pinMode(8, OUTPUT);
  digitalWrite(8, HIGH);

  WiFi.mode(WIFI_STA);
  WiFi.disconnect();

  if (esp_now_init() == ESP_OK) {
    esp_now_register_recv_cb(esp_now_recv_cb_t(onDataRecv));
  }
}

void loop() {
  // 空转，数据转发依靠射频底层硬件中断
}